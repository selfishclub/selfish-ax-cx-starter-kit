# 셀피쉬클럽 CX 스타터 키트 — 환경변수 본보기 (이름만)
#
# 이 파일은 깃에 올라가요. **값은 절대 여기에 적지 않아요.**
# 실제 값은 `.env.local`에 넣고, 그 파일은 깃이 무시해요(.gitignore).
#   cp .env.example .env.local
# 비밀번호 · 토큰은 AI 채팅에 붙여 넣지 말고 .env.local에 직접 넣어요.

# ── 카드를 받을 곳 (슬랙) ──────────────────────────────
SLACK_BOT_TOKEN=          # 슬랙 앱의 Bot Token (xoxb-…)
SLACK_APP_TOKEN=          # 버튼을 받기 위한 App-Level Token (xapp-…)
SLACK_CX_CHANNEL=         # 카드를 올릴 채널 ID (예: #cx-inbox 의 ID)

# ── 초안을 쓰는 AI ─────────────────────────────────────
CX_AI_PROVIDER=cli        # cli = Claude Code 구독으로(API 키 불필요) / api = Claude API
ANTHROPIC_MODEL=          # 비워 두면 기본값. api 일 때 ANTHROPIC_API_KEY 도 필요
# ANTHROPIC_API_KEY=      # api 프로바이더일 때만

# ── 수집기 ─────────────────────────────────────────────
CX_WATCH_MINUTES=5        # 몇 분마다 문의를 확인할지
KAKAO_CHANNEL_ID=         # 카카오 채널 관리자 주소의 채널 ID (business.kakao.com/<이것>/chats)
CX_ANSWER_CHECK_MINUTES=15  # 카카오에서 직접 답했는지 몇 분마다 확인할지

# ── 초안이 보는 것 ──────────────────────────────────────
CX_BRAND_NAME=            # 초안 프롬프트의 우리 이름 (예: 함흥물냉면 서초점). 비우면 「우리 커뮤니티」
# CX_POLICY_FILE=         # 정책 문서 경로. 비우면 policy/answers.md, 그것도 없으면 policy/answers.sample.md
# CX_FACTS_FILE=          # 초안이 정책과 함께 읽을 추가 사실 파일(선택)

# ── 운영 알림 · 브리핑 ─────────────────────────────────
SLACK_BRIEFING_CHANNEL=   # 로그인 풀림 알림 · 아침 브리핑을 올릴 채널 ID. 비우면 카드 채널과 같은 곳
CX_BRIEFING_MODEL=sonnet  # 브리핑 제안 · 주 1회 학습에 쓸 Claude 모델 별칭

# ── 대시보드 (선택) ─────────────────────────────────────
# SUPABASE_URL=           # 상태 한 줄을 Supabase 표 cx_status 에 적고 싶을 때만
# SUPABASE_SERVICE_ROLE_KEY=

# ── 안전장치 ───────────────────────────────────────────
CX_SEND_ENABLED=false     # true 로 바꾸기 전까지 실제 발송은 나가지 않아요 (비상 스위치)
